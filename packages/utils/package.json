{
  "name": "@repo/utils",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./modules/errorStatus": {
      "types": "./src/modules/errorStatus.ts",
      "default": "./src/modules/errorStatus.ts"
    },
    "./modules/mitt": {
      "types": "./src/modules/mitt.ts",
      "default": "./src/modules/mitt.ts"
    },
    "./modules/random": {
      "types": "./src/modules/random.ts",
      "default": "./src/modules/random.ts"
    },
    "./modules/aes": {
      "types": "./src/modules/aes.ts",
      "default": "./src/modules/aes.ts"
    },
    "./modules/themeColor": {
      "types": "./src/modules/themeColor.ts",
      "default": "./src/modules/themeColor.ts"
    },
    "./modules/tree": {
      "types": "./src/modules/tree.ts",
      "default": "./src/modules/tree.ts"
    },
    "./modules/dexie": {
      "types": "./src/modules/dexie.ts",
      "default": "./src/modules/dexie.ts"
    },
    "./types": {
      "types": "./src/types/index.ts",
      "default": "./src/types/index.ts"
    },
    "./trigger": {
      "types": "./src/trigger/index.ts",
      "default": "./src/trigger/index.ts"
    },
    "./sse": {
      "types": "./src/sse/index.ts",
      "default": "./src/sse/index.ts"
    },
    "./sse/*": {
      "types": "./src/sse/*.ts",
      "default": "./src/sse/*.ts"
    },
    "./*": "./src/*"
  },
  "scripts": {
    "build": "tsc",
    "lint": "eslint src --ext .ts,.tsx",
    "test": "vitest run",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@microsoft/fetch-event-source": "^2.0.1",
    "@repo/config": "workspace:*",
    "@tanstack/vue-query": "catalog:",
    "@vueuse/core": "catalog:",
    "axios": "^1.7.9",
    "crypto-js": "^4.2.0",
    "dexie": "^4.4.6",
    "mitt": "^3.0.1",
    "vue": "catalog:"
  },
  "devDependencies": {
    "@types/crypto-js": "^4.2.2",
    "fake-indexeddb": "^6.2.5",
    "rimraf": "catalog:",
    "typescript": "catalog:",
    "vitest": "^1.6.0"
  }
}
