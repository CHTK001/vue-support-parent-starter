{
  "name": "@repo/login",
  "version": "1.0.0",
  "description": "登录页面包（提供 default / koi 等主题，按 app.yaml 配置驱动）",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./*": "./src/*",
    "./themes/*": "./src/themes/*"
  },
  "files": [
    "src"
  ],
  "sideEffects": [
    "**/*.css",
    "**/*.scss"
  ],
  "scripts": {
    "build": "pnpm unbuild",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@element-plus/icons-vue": "catalog:",
    "element-plus": "catalog:",
    "pinia": "catalog:",
    "vue": "catalog:",
    "vue-router": "catalog:",
    "vue-i18n": "catalog:",
    "ts-md5": "catalog:",
    "@repo/components": "workspace:*",
    "@repo/config": "workspace:*",
    "@repo/core": "workspace:*",
    "@repo/utils": "workspace:*"
  },
  "devDependencies": {
    "typescript": "catalog:",
    "unbuild": "catalog:"
  }
}