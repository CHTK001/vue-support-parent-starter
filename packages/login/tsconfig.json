{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": false,
    "jsx": "preserve",
    "importHelpers": true,
    "experimentalDecorators": true,
    "strictFunctionTypes": false,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "allowSyntheticDefaultImports": true,
    "forceConsistentCasingInFileNames": true,
    "sourceMap": true,
    "baseUrl": ".",
    "allowJs": false,
    "resolveJsonModule": true,
    "lib": ["ESNext", "DOM"],
    "paths": {
      "@/*": ["src/*"],
      "@repo/components/*": ["../components/*"],
      "@repo/components": ["../components"],
      "@repo/config": ["../config"],
      "@repo/config/*": ["../config/*"],
      "@repo/core": ["../core"],
      "@repo/core/*": ["../core/*"],
      "@repo/utils": ["../utils"],
      "@layout/default/*": ["../../layout/default/src/*"],
      "@layout/default": ["../../layout/default/src"],
      "@layout/koi/*": ["../../layout/koi/src/*"],
      "@layout/koi": ["../../layout/koi/src"]
    },
    "types": ["vite/client", "element-plus/global"]
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "src/**/*.vue",
    "src/**/*.d.ts"
  ],
  "exclude": [
    "dist",
    "**/*.js",
    "node_modules",
    "**/node_modules/**"
  ]
}