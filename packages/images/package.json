{
  "name": "@repo/images",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "业务图片资源包 —— 仅打包被实际 import 的图片，未引用的一律不进入产物",
  "files": ["src"],
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./*": "./src/*"
  },
  "scripts": {
    "lint": "echo \"no lint for images (resources only)\"",
    "clean": "rimraf dist"
  },
  "devDependencies": {
    "rimraf": "catalog:",
    "typescript": "catalog:"
  }
}
