{
  "name": "@repo/theme",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./default": {
      "types": "./src/themes/default/index.ts",
      "default": "./src/themes/default/index.ts"
    },
    "./koi": {
      "types": "./src/themes/koi/index.ts",
      "default": "./src/themes/koi/index.ts"
    },
    "./*": "./src/*"
  },
  "scripts": {
    "build": "tsc",
    "lint": "eslint src --ext .ts,.tsx",
    "clean": "rimraf dist"
  },
  "devDependencies": {
    "typescript": "catalog:",
    "rimraf": "catalog:"
  }
}
