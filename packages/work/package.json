{
  "name": "@repo/work",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./timer": {
      "types": "./src/timer/index.ts",
      "default": "./src/timer/index.ts"
    },
    "./countdown": {
      "types": "./src/countdown/index.ts",
      "default": "./src/countdown/index.ts"
    },
    "./*": "./src/*"
  },
  "scripts": {
    "build": "tsc",
    "lint": "eslint src --ext .ts,.tsx",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@repo/utils": "workspace:*"
  },
  "devDependencies": {
    "typescript": "catalog:",
    "rimraf": "catalog:"
  }
}
