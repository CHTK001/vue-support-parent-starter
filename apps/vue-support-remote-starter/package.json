{
  "name": "vue-support-remote-starter",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "serve": "pnpm dev",
    "build": "rimraf dist && cross-env NODE_OPTIONS=--max-old-space-size=8192 vite build",
    "build:staging": "rimraf dist && cross-env NODE_OPTIONS=--max-old-space-size=8192 vite build --mode test",
    "preview": "vite preview",
    "preview:build": "pnpm build && vite preview",
    "typecheck": "tsc --noEmit && vue-tsc --noEmit --skipLibCheck"
  },
  "dependencies": {
    "@pages/remote": "workspace:^",
    "@pureadmin/utils": "catalog:",
    "@techui/scifi": "catalog:",
    "@vueuse/core": "catalog:",
    "element-plus": "catalog:",
    "lodash-es": "catalog:",
    "pinia": "catalog:",
    "vue": "catalog:",
    "vue-router": "catalog:"
  },
  "devDependencies": {
    "@repo/build-config": "workspace:^",
    "@types/node": "catalog:",
    "@vitejs/plugin-vue": "catalog:",
    "cross-env": "catalog:",
    "rimraf": "catalog:",
    "sass": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vue-tsc": "catalog:"
  }
}
