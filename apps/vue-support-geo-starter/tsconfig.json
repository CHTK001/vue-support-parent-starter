{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "jsx": "preserve",
    "types": ["vite/client"],
    "paths": {
      "@/*": ["apps/vue-support-geo-starter/src/*"]
    }
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "src/**/*.vue",
    "app.yaml",
    "../../packages/core/src/**/*.d.ts"
  ],
  "exclude": [
    "../../packages/ui",
    "../../packages/theme"
  ]
}
