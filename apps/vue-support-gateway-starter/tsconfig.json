{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "types": ["vite/client"],
    "paths": {
      "@repo/ui/re-empty-state": ["packages/ui/src/components/ReEmptyState/index"],
      "@repo/ui/re-section-head": ["packages/ui/src/components/ReSectionHead/index"],
      "@repo/ui/re-state-dot": ["packages/ui/src/components/ReStateDot/index"],
      "@repo/ui/re-stat-card": ["packages/ui/src/components/ReStatCard/index"],
      "@repo/ui/re-card": ["packages/ui/src/components/ReCard/index"],
      "@repo/ui/re-table": ["packages/ui/src/components/ReTable/index"]
    }
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.vue",
    "src/**/*.d.ts",
    "../../packages/core/src/**/*.d.ts",
    "../../packages/ui/src/**/*.d.ts",
    "../../pages/gateway/src/**/*.d.ts"
  ]
}