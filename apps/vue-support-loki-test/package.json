{
  "name": "vue-support-loki-test",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "serve": "pnpm dev",
    "build:wasm": "cd ../../packages/codec-wasm && pnpm build",
    "build": "pnpm build:wasm && rimraf dist && cross-env NODE_OPTIONS=--max-old-space-size=8192 vite build",
    "build:staging": "pnpm build:wasm && rimraf dist && cross-env NODE_OPTIONS=--max-old-space-size=8192 vite build --mode test",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && vue-tsc --noEmit --skipLibCheck",
    "lint": "eslint --cache --max-warnings 0 \"{src,mock,build}/**/*.{vue,js,ts,tsx}\" --fix",
    "prepare": "husky",
    "preinstall": "npx only-allow pnpm"
  },
  "dependencies": {
    "@layout/default": "workspace:^",
    "@antv/g6": "catalog:",
    "@pureadmin/descriptions": "catalog:",
    "@pureadmin/table": "catalog:",
    "@pureadmin/utils": "catalog:",
    "@vueuse/core": "catalog:",
    "animate.css": "catalog:",
    "axios": "catalog:",
    "crypto-js": "catalog:",
    "dayjs": "catalog:",
    "echarts": "catalog:",
    "element-plus": "catalog:",
    "highlight.js": "catalog:",
    "jose": "catalog:",
    "js-cookie": "catalog:",
    "mitt": "catalog:",
    "nprogress": "catalog:",
    "pinia": "catalog:",
    "responsive-storage": "catalog:",
    "sortablejs": "catalog:",
    "vue": "catalog:",
    "vue-router": "catalog:",
    "vue-types": "catalog:"
  },
  "devDependencies": {
    "@repo/build-config": "workspace:^",
    "@iconify-icons/ep": "catalog:",
    "@iconify-icons/ri": "catalog:",
    "@iconify/vue": "catalog:",
    "@intlify/unplugin-vue-i18n": "catalog:",
    "@originjs/vite-plugin-commonjs": "catalog:",
    "@types/node": "catalog:",
    "@types/nprogress": "catalog:",
    "@types/qs": "catalog:",
    "@vitejs/plugin-vue": "catalog:",
    "@vitejs/plugin-vue-jsx": "catalog:",
    "autoprefixer": "catalog:",
    "cross-env": "catalog:",
    "cssnano": "catalog:",
    "devtools-detector": "catalog:",
    "postcss": "catalog:",
    "postcss-import": "catalog:",
    "sass": "catalog:",
    "stylelint": "catalog:",
    "stylelint-config-recess-order": "catalog:",
    "stylelint-config-recommended-vue": "catalog:",
    "stylelint-config-standard-scss": "catalog:",
    "tailwindcss": "catalog:",
