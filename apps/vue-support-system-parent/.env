# 平台本地运行端口号
VITE_PORT = 8848

# 是否隐藏首页 隐藏 true 不隐藏 false （勿删除，VITE_HIDE_HOME只需在.env文件配置）
VITE_HIDE_HOME = false

# 是否启用轻量构建（默认 true，降低构建内存占用）
# true:
# - 关闭主产物 minify（不做 esbuild/terser 压缩）
# - 关闭额外产物压缩插件（gzip/brotli）
# - 更适合本地开发机和低内存环境
# - 产物仍然是可直接部署使用的正式构建结果
# false:
# - 主产物恢复 esbuild 压缩
# - 会按 VITE_COMPRESSION 继续生成 gzip/brotli 文件
# - 更适合 CI / 发布机构建
VITE_LIGHT_BUILD = true
