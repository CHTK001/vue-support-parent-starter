# 平台本地运行端口号
VITE_PORT = 8848

# 开发环境读取配置文件路径
VITE_PUBLIC_PATH = /
# 开发环境读取配置文件路径
# 开发环境路由历史模式（Hash模式传"hash"、HTML5模式传"h5"、Hash模式带base参数传"hash,base参数"、HTML5模式带base参数传"h5,base参数"）
VITE_ROUTER_HISTORY = "hash"
# 开发环境接口前缀
VITE_APP_API_BASE_URL=/system/api
VITE_APP_DEFAULT_USERNAME = admin
VITE_APP_DEFAULT_PASSWORD = 123456
# VITE_APP_DEFAULT_USERNAME = test
# VITE_APP_DEFAULT_PASSWORD = 123qweasd

# 是否启用轻量构建（默认 true，降低构建内存占用）
# true:
# - 关闭主产物 minify（不做 esbuild/terser 压缩）
# - 关闭额外产物压缩插件（gzip/brotli）
# - 更适合本地开发机和低内存环境
# - 产物仍然是可直接部署使用的正式构建结果
# false:
# - 主产物恢复 esbuild 压缩
# - 会按 VITE_COMPRESSION 继续生成 gzip/brotli 文件
# - 更适合 CI / 发布机构建
VITE_LIGHT_BUILD = true
