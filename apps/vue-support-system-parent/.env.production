# 线上环境平台打包路径
VITE_PUBLIC_PATH = /system/

# 线上环境路由历史模式（Hash模式传"hash"、HTML5模式传"h5"、Hash模式带base参数传"hash,base参数"、HTML5模式带base参数传"h5,base参数"）
VITE_ROUTER_HISTORY = "hash"

# 是否在打包时使用cdn替换本地库 替换 true 不替换 false
VITE_CDN = false

# 是否启用gzip压缩或brotli压缩（分两种情况，删除原始文件和不删除原始文件）
# 压缩时不删除原始文件的配置：gzip、brotli、both（同时开启 gzip 与 brotli 压缩）、none（不开启压缩，默认）
# 压缩时删除原始文件的配置：gzip-clear、brotli-clear、both-clear（同时开启 gzip 与 brotli 压缩）、none（不开启压缩，默认）
VITE_COMPRESSION = "gzip"

# 是否启用轻量构建（默认 true，会覆盖压缩为 none，降低构建内存占用）
# true:
# - 关闭主产物 minify（不做 esbuild/terser 压缩）
# - 关闭额外产物压缩插件（gzip/brotli）
# - 更适合本地开发机和低内存环境
# - 产物仍然是可直接部署使用的正式构建结果
# false:
# - 主产物恢复 esbuild 压缩
# - 会按 VITE_COMPRESSION 继续生成 gzip/brotli 文件
# - 更适合 CI / 发布机构建
VITE_LIGHT_BUILD = true
