{
  "compilerOptions": {
    /* 语言和模块配置 */
    "target": "ES2020",
    "module": "ESNext",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    
    /* 类型检查 - 初期宽松模式 */
    "strict": false,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "strictFunctionTypes": true,
    "strictBindCallApply": true,
    "strictPropertyInitialization": false,
    "noImplicitThis": true,
    "alwaysStrict": true,
    
    /* 未使用的代码检查 - 初期关闭 */
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noImplicitReturns": false,
    "noFallthroughCasesInSwitch": false,
    
    /* 互操作性 */
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "forceConsistentCasingInFileNames": true,
    
    /* 输出配置 */
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "removeComments": false,
    
    /* 性能优化 */
    "skipLibCheck": true,
    "isolatedModules": true,
    
    /* Vue 特定配置 */
    "jsx": "preserve",
    "jsxFactory": "h",
    "jsxFragmentFactory": "Fragment",
    
    /* 路径解析 */
    "baseUrl": ".",
    /* ignoreDeprecations：与 catalog 锁定的 TypeScript 5.x 对应（"6.0" 是 TS6 才接受的值） */
    "ignoreDeprecations": "5.0",
    "paths": {
      "@/*": ["./src/*"],
      /* 复用 pages/filesystem 的文件存储管理页（见「系统配置 → 文件存储」） */
      "@pages/filesystem": ["../../pages/filesystem/src/index.ts"],
      "@pages/filesystem/*": ["../../pages/filesystem/*"],
      /* 渠道管理页：已从 pages/ai 抽离出的独立包（见「系统设置 → 渠道管理」） */
      "@pages/channel": ["../../pages/channel/src/index.ts"],
      "@pages/channel/*": ["../../pages/channel/src/*"]
    },
    
    /* 类型根目录 */
    "typeRoots": ["./node_modules/@types", "./src/types"]
  },
  
  "include": [
    "src/**/*.ts",
    "src/**/*.d.ts",
    "src/**/*.tsx",
    "src/**/*.vue",
    "../../pages/filesystem/src/**/*.d.ts",
    "../../pages/channel/src/**/*.d.ts"
  ],
  
  "exclude": [
    "node_modules",
    "dist",
    "build"
  ],
  
  "vueCompilerOptions": {
    "target": 3.5,
    "plugins": []
  }
}
