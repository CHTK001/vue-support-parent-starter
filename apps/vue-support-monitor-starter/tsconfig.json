{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "types": ["vite/client"],
    "baseUrl": ".",
    "paths": {
      "@repo/ui/components/*": ["../../packages/ui/src/components/*"],
      "@repo/theme/koi/framework": ["../../packages/theme/src/themes/koi/framework"],
      "@repo/theme/koi/*": ["../../packages/theme/src/themes/koi/*"],
      // 通配符落在「页面根」：业务代码统一写 @pages/<pkg>/src/... 的深路径，
      // 若这里的目标已含 src，会叠加成 src/src/... 而全部解析失败（TS2307）。
      "@pages/server/*": ["../../pages/server/*"],
      "@pages/server": ["../../pages/server/src/index.ts"],
      "@pages/docker/*": ["../../pages/docker/*"],
      "@pages/docker": ["../../pages/docker/src/index.ts"],
      "@pages/monitor/*": ["../../pages/monitor/*"],
      "@pages/monitor": ["../../pages/monitor/src/index.ts"],
      "@pages/filesystem/*": ["../../pages/filesystem/*"],
      "@pages/filesystem": ["../../pages/filesystem/src/index.ts"],
      "@pages/datasource/*": ["../../pages/datasource/*"],
      "@pages/datasource": ["../../pages/datasource/src/index.ts"],
      // 调试中心（CDP）：运维管理菜单 -> /debug，视图 + API + 路由同源
      "@pages/debug/*": ["../../pages/debug/*"],
      "@pages/debug": ["../../pages/debug/src/index.ts"],
      "@pages/device/*": ["../../pages/device/*"],
      "@pages/device": ["../../pages/device/src/index.ts"],
      // APM 观测台（@pages/apm）：路由入口 = @pages/apm/src/routes
      "@pages/apm/*": ["../../pages/apm/*"],
      "@pages/apm": ["../../pages/apm/src/index.ts"],
      // 监控大屏卡片的领域包（apm / actuator）要 import "@pages/system" 的类型与
      // defineMonitorCardContribution；vite 侧由本地 alias 解析，TS 侧必须同时给出
      // 等价 paths，否则这些包内每一处 @pages/system 都是 TS2307。
      "@pages/system/*": ["../../pages/system/*"],
      "@pages/system": ["../../pages/system/src/index.ts"],
      "@pages/actuator/*": ["../../pages/actuator/*"],
      "@pages/actuator": ["../../pages/actuator/src/index.ts"],
      // 内网穿透（ngrok / Cloudflare）页面包：业务代码统一写 @pages/tunnel/src/...
      "@pages/tunnel/*": ["../../pages/tunnel/*"],
      "@pages/tunnel": ["../../pages/tunnel/src/index.ts"],
      // ReMap 内部用（workspace 包，pages/device 已声明依赖；此处给 TS 提供解析，
      // 与根 tsconfig 的 "@repo/re-map"、device-starter 同一口径）
      "@repo/re-map": ["../../packages/ui/re-map"],
      // 调试中心（CDP）@pages/debug 需要的 @repo/utils、@repo/core 走 ws 文件：
      // 根 tsconfig 的 paths 在 app tsconfig 下相对 baseUrl 解析，这里给出等价路径
      "@repo/utils": ["../../packages/utils/src"],
      "@repo/core": ["../../packages/core/src"]
    }
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.vue",
    "src/**/*.d.ts",
    "../../packages/core/src/**/*.d.ts",
    "../../pages/server/src/**/*.d.ts",
    "../../pages/message/src/**/*.d.ts",
    "../../pages/hotsport/src/**/*.d.ts",
    "../../pages/filesystem/src/**/*.d.ts",
    "../../pages/datasource/src/**/*.d.ts",
    "../../pages/docker/src/**/*.d.ts",
      "../../pages/device/src/**/*.d.ts",
      "../../pages/debug/src/**/*.d.ts"
  ]
}
