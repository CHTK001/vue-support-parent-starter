{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "types": ["vite/client"],
    "baseUrl": ".",
    "paths": {
      "@repo/ui/components/*": ["../../packages/ui/src/components/*"],
      "@repo/theme/koi/framework": ["../../packages/theme/src/themes/koi/framework"],
      "@repo/theme/koi/*": ["../../packages/theme/src/themes/koi/*"],
      // 通配符落在「页面根」：业务代码统一写 @pages/<pkg>/src/... 的深路径，
      // 若这里的目标已含 src，会叠加成 src/src/... 而全部解析失败（TS2307）。
      "@pages/server/*": ["../../pages/server/*"],
      "@pages/server": ["../../pages/server/src/index.ts"],
      "@pages/docker/*": ["../../pages/docker/*"],
      "@pages/docker": ["../../pages/docker/src/index.ts"],
      "@pages/monitor/*": ["../../pages/monitor/*"],
      "@pages/monitor": ["../../pages/monitor/src/index.ts"],
      // OSGi 插件中心（@pages/osgi）：分组「插件中心」+ 叶子 /collect/osgi，
      // 路由入口 = @pages/osgi/src/routes（深导入口径，见 src/router/index.ts）。
      "@pages/osgi/*": ["../../pages/osgi/*"],
      "@pages/osgi": ["../../pages/osgi/src/index.ts"],
      // osgi 包内文件的 @repo/* 解析（与 collect-scheduler 同款）：包文件按
      // node_modules 最近优先解析，而 pnpm 只在各 app 的 node_modules 放了 @repo 链接，
      // 从 pages/osgi/src 向上找不到（根 node_modules/@repo 为空）→ TS2307。
      // 这里按 osgi 包实际 import 面显式列映射（re-* 子入口不能靠 * 通配，见根
      // tsconfig 的生成段注释）。
      "@repo/config": ["../../packages/config/src"],
      "@repo/pinia": ["../../packages/pinia/src"],
      "@repo/pinia/*": ["../../packages/pinia/src/*"],
      // 监控大屏卡片契约包（@repo/monitor-cards）：领域包与宿主共用的类型 + 注册表。
      // 与根 tsconfig 同名映射，app 的 paths 会整体覆盖根 paths，必须在此显式列出，
      // 否则 @pages/system 的 cards/registry.ts、cards/types.ts 全部 TS2307，
      // 连带 useMonitorCards / MonitorCardLibrary 里的 map 回调参数隐式 any。
      "@repo/monitor-cards": ["../../packages/monitor-cards/src"],
      "@repo/monitor-cards/*": ["../../packages/monitor-cards/src/*"],
      "@repo/ui/re-button": ["../../packages/ui/src/components/ReButton/index.ts"],
      "@repo/ui/re-tag": ["../../packages/ui/src/components/ReTag/index.ts"],
      "@repo/ui/re-table": ["../../packages/ui/src/components/ReTable/index.ts"],
      // P2P 房间（@pages/room）：不占菜单也不占路由，由「服务管理」页内嵌 RoomView。
      // paths 保留给类型解析（monitor 与宿主都可能 import 本包）。
      "@pages/room/*": ["../../pages/room/*"],
      "@pages/room": ["../../pages/room/src/index.ts"],
      "@pages/filesystem/*": ["../../pages/filesystem/*"],
      "@pages/filesystem": ["../../pages/filesystem/src/index.ts"],
      "@pages/datasource/*": ["../../pages/datasource/*"],
      "@pages/datasource": ["../../pages/datasource/src/index.ts"],
      // 数据源运行时配置页（@pages/datasource-hub）：Calcite 联邦 / 分库分表运行期配置，
      // 路由入口 = @pages/datasource-hub/src/routes（深导入口径，同 datasource）。
      "@pages/datasource-hub/*": ["../../pages/datasource-hub/*"],
      "@pages/datasource-hub": ["../../pages/datasource-hub/src/index.ts"],
      // 调试中心（CDP）：并进「分析管理」菜单 -> /debug，视图 + API + 路由同源
      "@pages/debug/*": ["../../pages/debug/*"],
      "@pages/debug": ["../../pages/debug/src/index.ts"],
      // 日志中心（@pages/logger）：分组「日志中心」+ /logger/* 四叶，
      // 路由入口 = @pages/logger/src/routes（深导入口径，同 debug）。
      "@pages/logger/*": ["../../pages/logger/*"],
      "@pages/logger": ["../../pages/logger/src/index.ts"],
      // CDP 工作台 UI（@pages/cdp）：浏览器式壳（@pages/debug）从这里取工作台组件
      // 与客户端通道。与根 tsconfig / createVite 共享别名同口径：@pages/cdp 指
      // pages/cdp/src（不是包根），业务深导入写 @pages/cdp/components/...。
      "@pages/cdp/*": ["../../pages/cdp/src/*"],
      "@pages/cdp": ["../../pages/cdp/src/index.ts"],
      "@pages/device/*": ["../../pages/device/*"],
      "@pages/device": ["../../pages/device/src/index.ts"],
      // APM 观测台（@pages/apm）：路由入口 = @pages/apm/src/routes
      "@pages/apm/*": ["../../pages/apm/*"],
      "@pages/apm": ["../../pages/apm/src/index.ts"],
      // 渠道管理（@pages/channel）：宿主直接挂它的 ChannelManagementPage，
      // 通配符同样落在「页面根」，业务写 @pages/channel/src/...
      "@pages/channel/*": ["../../pages/channel/*"],
      "@pages/channel": ["../../pages/channel/src/index.ts"],
      // 设备远程控制（@pages/control）：WebRTC 信令 + 桌面视频 + 键鼠遥控，
      // 路由入口 = @pages/control/src/routes。
      "@pages/control/*": ["../../pages/control/*"],
      "@pages/control": ["../../pages/control/src/index.ts"],
      // 被复用的 @pages/channel 页面头以 "@/components/ui/RePageHead.vue" 引用
      // pages/ai/src（与根 tsconfig 的 "@/*" 同一口径）；monitor 自身不使用 "@/..."。
      "@/*": ["../../pages/ai/src/*"],
      // 监控大屏卡片的领域包（apm / actuator）要 import "@pages/system" 的类型与
      // defineMonitorCardContribution；vite 侧由本地 alias 解析，TS 侧必须同时给出
      // 等价 paths，否则这些包内每一处 @pages/system 都是 TS2307。
      "@pages/system/*": ["../../pages/system/*"],
      "@pages/system": ["../../pages/system/src/index.ts"],
      "@pages/actuator/*": ["../../pages/actuator/*"],
      "@pages/actuator": ["../../pages/actuator/src/index.ts"],
      // 内网穿透（ngrok / Cloudflare）页面包：业务代码统一写 @pages/tunnel/src/...
      "@pages/tunnel/*": ["../../pages/tunnel/*"],
      "@pages/tunnel": ["../../pages/tunnel/src/index.ts"],
      // 观测大屏（@pages/bigscreen，目录 pages/screen）：路由入口 = @pages/bigscreen/src/routes。
      // app tsconfig 的 paths 整体覆盖根配置，必须在这里同时给出等价映射，否则宿主
      // src/router/index.ts 的 @pages/bigscreen/src/routes 是 TS2307。
      "@pages/bigscreen/*": ["../../pages/screen/*"],
      "@pages/bigscreen": ["../../pages/screen/src/index.ts"],
      // 账号管理（账号资产 + 模板管理 + 消息模板）：@pages/account
      //（2026-11-19 自后端仓 spring-support-account-starter/web 迁入 pages/account）。
      "@pages/account/*": ["../../pages/account/*"],
      "@pages/account": ["../../pages/account/src/index.ts"],
      // ReMap 内部用（workspace 包，pages/device 已声明依赖；此处给 TS 提供解析，
      // 与根 tsconfig 的 "@repo/re-map"、device-starter 同一口径）
      "@repo/re-map": ["../../packages/ui/re-map"],
      // 调试中心（CDP）@pages/debug 需要的 @repo/utils、@repo/core 走 ws 文件：
      // 根 tsconfig 的 paths 在 app tsconfig 下相对 baseUrl 解析，这里给出等价路径
      "@repo/utils": ["../../packages/utils/src"],
      "@repo/core": ["../../packages/core/src"]
    }
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.vue",
    "src/**/*.d.ts",
    "../../packages/core/src/**/*.d.ts",
    "../../packages/theme/src/**/*.d.ts",
    "../../pages/server/src/**/*.d.ts",
    "../../pages/message/src/**/*.d.ts",
    "../../pages/hotsport/src/**/*.d.ts",
    "../../pages/filesystem/src/**/*.d.ts",
    "../../pages/datasource/src/**/*.d.ts",
    "../../pages/docker/src/**/*.d.ts",
      "../../pages/device/src/**/*.d.ts",
      "../../pages/debug/src/**/*.d.ts",
      "../../pages/screen/src/**/*.d.ts",
      // 账号管理前端（@pages/account）的全局声明：jquery / vue-plugin-hiprint 的 UMD 类型、
      // window.$ / window.hiprint 扩展。缺了它模板设计器与预览页全是 TS7016/TS2551。
      "../../pages/account/src/**/*.d.ts"
  ]
}
