{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "types": [
      "vite/client"
    ],
    "paths": {
      "@pages/server/*": [
        "../../pages/server/*"
      ],
      "@pages/server": [
        "../../pages/server/src/index.ts"
      ]
    },
    "baseUrl": "."
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.vue",
    "src/**/*.d.ts",
    "../../packages/core/src/**/*.d.ts",
    "../../pages/message/src/**/*.d.ts",
    "../../pages/server/src/**/*.d.ts"
  ]
}