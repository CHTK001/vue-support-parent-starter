{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "types": ["vite/client"],
    "noUnusedLocals": false,
    "baseUrl": ".",
    "paths": {
      "@repo/theme/koi/framework": ["../../packages/theme/src/themes/koi/framework"],
      "@repo/theme/koi/*": ["../../packages/theme/src/themes/koi/*"],
      "@repo/ui/components/*": ["../../packages/ui/src/components/*"],
      "@pages/datasource/*": ["../../pages/datasource/*"],
      "@pages/datasource": ["../../pages/datasource/src/index.ts"],
      "@pages/collect/*": ["../../pages/collect/*"],
      "@pages/collect": ["../../pages/collect/src/index.ts"],
      "@pages/job/*": ["../../pages/job/*"],
      "@pages/job": ["../../pages/job/src/index.ts"],
      "@pages/osgi/*": ["../../pages/osgi/*"],
      "@pages/osgi": ["../../pages/osgi/src/index.ts"],
      "@repo/config": ["../../packages/config/src"],
      "@repo/config/*": ["../../packages/config/src/*"],
      "@repo/core": ["../../packages/core/src"],
      "@repo/core/*": ["../../packages/core/src/*"],
      "@repo/utils": ["../../packages/utils/src"],
      "@repo/utils/*": ["../../packages/utils/src/*"],
      "@repo/ui/re-button": ["../../packages/ui/src/components/ReButton/index.ts"],
      "@repo/ui/re-tag": ["../../packages/ui/src/components/ReTag/index.ts"],
      "@repo/ui/re-table": ["../../packages/ui/src/components/ReTable/index.ts"]
    }
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.vue",
    "src/**/*.d.ts",
    "vite.config.ts",
    "../../packages/core/src/**/*.d.ts"
  ]
}
