{
  "name": "vue-support-parent-starter",
  "version": "2.0.0",
  "private": true,
  "description": "vue-support-parent-starter turbo monorepo",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "clean": "turbo run clean",
    "version:sync": "node scripts/sync-version.mjs",
    "version:check": "node scripts/sync-version.mjs --check",
    "version:patch": "node scripts/sync-version.mjs --bump patch",
    "version:minor": "node scripts/sync-version.mjs --bump minor",
    "version:major": "node scripts/sync-version.mjs --bump major",
    "config:check": "node scripts/validate-app-config.mjs",
    "verify:security": "node scripts/verify-safe-path.mts && node scripts/verify-single-flight.mts && node scripts/verify-session-scope.mts && node scripts/verify-token-origin.mts && node scripts/verify-object-ticket.mts && node scripts/verify-html-preview.mts",
    "surface:check": "node scripts/check-ui-surface.mjs",
    "surface:baseline": "node scripts/check-ui-surface.mjs --update"
  },
  "devDependencies": {
    "@element-plus/icons-vue": "catalog:",
    "@types/node": "catalog:",
    "@types/sortablejs": "^1.15.9",
    "@types/three": "^0.187.0",
    "@unocss/preset-attributify": "catalog:",
    "@unocss/preset-icons": "catalog:",
    "@unocss/preset-typography": "catalog:",
    "@unocss/preset-wind3": "catalog:",
    "@unocss/transformer-directives": "catalog:",
    "@unocss/transformer-variant-group": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "@vitejs/plugin-vue": "catalog:",
    "axios": "^1.8.0",
    "element-plus": "catalog:",
    "eslint": "^9.17.0",
    "flow-remove-types": "^2.325.0",
    "js-cookie": "^3.0.5",
    "js-yaml": "^4.1.0",
    "pinia": "catalog:",
    "rimraf": "^6.0.0",
    "ts-md5": "^1.3.1",
    "turbo": "^2.2.3",
    "typescript": "catalog:",
    "unocss": "catalog:",
    "vite": "^8.2.0",
    "vite-plugin-vue-setup-extend": "^0.4.0",
    "vue": "catalog:",
    "vue-i18n": "catalog:",
    "vue-router": "catalog:"
  },
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  },
  "dependencies": {
    "@microsoft/fetch-event-source": "^2.0.1",
    "sortablejs": "^1.15.7",
    "vue3-slide-verify": "^1.1.8"
  }
}
