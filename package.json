{
  "name": "vue-support-parent-starter",
  "version": "1.0.0",
  "description": "Vue 3 + TypeScript monorepo starter with multiple apps, packages, layouts and pages.",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "turbo run dev",
    "dev:monitor": "turbo run dev --filter=vue-support-monitor-starter",
    "dev:project": "turbo run dev --filter=vue-support-project-starter",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "clean": "rimraf .turbo && turbo run clean",
    "format": "prettier --write \"**/*.{js,ts,json,tsx,css,scss,vue,html,md}\"",
    "prepare": "husky"
  },
  "devDependencies": {
    "husky": "catalog:",
    "rimraf": "catalog:",
    "turbo": "catalog:",
    "prettier": "catalog:",
    "lint-staged": "catalog:"
  },
  "engines": {
    "node": "^18.18.0 || ^20.9.0 || >=21.1.0",
    "pnpm": ">=9"
  },
  "packageManager": "pnpm@9.15.0",
  "lint-staged": {
    "*.{js,ts,tsx,vue}": [
      "eslint --fix --max-warnings 0"
    ],
    "*.{css,scss,vue}": [
      "stylelint --fix"
    ],
    "*.{js,ts,json,tsx,css,scss,vue,html,md}": [
      "prettier --write"
    ]
  }
}
