# 依赖
node_modules/
.pnpm-store/

# 构建产物
dist/
dist-ssr/
# node 服务端打包产物与验收快照目录（dist-node / dist-node2 / dist-verify2）。
# 这三个目录此前没被忽略，导致 git 每次 status/merge 都要遍历它们；
# 其中 vendor/ 与 wasm/ 子目录曾因权限问题报 "cannot stat ... Permission denied"，
# 直接把 merge / add 整个打断。它们只是构建输出，一律不入库。
dist-node*/
dist-node2/
dist-final-new3/
dist-final-new4/
dist-final-new5/
dist-verify2/
# Playwright 批量验收报告输出目录（同样是产物，且曾被 ACL 锁住打断 git 遍历）
playwright-bulk-report/
# 交付部署目录（rsync/发布产物，20MB+，不入库）
dist-deploy/
# 打包体积报告（rollup-plugin-visualizer 产物，几百 KB 的纯生成文件）。
# 曾经入库过，每次 build 都产生 diff，属于「临时文件必须放仓库外」的典型。
stats.html
# npm 的锁文件：本仓统一用 pnpm（pnpm-lock.yaml），
# 残缺的 package-lock.json 只会误导安装行为。
package-lock.json
# 备份/交换文件
*.bak
*.orig
*.rej
.turbo/
.turbo/**/
coverage/
*.local

# 防御性忽略：apps/ 下若意外残留 index.html（dev/build 都不应再生成到 app 根）
apps/*/index.html
# 反忽略：filestorage 的 index.html 是**手写源码**（多页入口壳，vite.config.ts 把它列为
# build input、sync-to-fs-server.ps1 把 dist/index.html 同步给后端 static/index.html），
# 不是 dev/build 生成的残留物。它此前被上面那条通配规则连带忽略、从未提交，
# 导致该应用 `pnpm build` 失败、dev 访问 / 返回 404。只放行这一个文件，其余 app 维持原规则。
!apps/vue-support-filestorage-starter/index.html

