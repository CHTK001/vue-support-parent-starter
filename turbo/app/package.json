{
  "name": "@repo/app",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./App.vue": {
      "types": "./src/App.vue",
      "default": "./src/App.vue"
    },
    "./react": {
      "types": "./src/react.ts",
      "default": "./src/react.ts"
    },
    "./*": "./src/*"
  },
  "scripts": {
    "clean": "rimraf dist"
  },
  "dependencies": {
    "vue": "catalog:",
    "vue-router": "catalog:",
    "pinia": "catalog:",
    "element-plus": "catalog:",
    "@element-plus/icons-vue": "catalog:",
    "vue-i18n": "catalog:",
    "@iconify/vue": "catalog:",
    "@tanstack/vue-query": "catalog:",
    "@repo/core": "workspace:*",
    "@repo/config": "workspace:*",
    "@repo/languages": "workspace:*",
    "@repo/theme": "workspace:*",
    "@repo/pinia": "workspace:*",
    "@repo/ui": "workspace:*",
    "@repo/utils": "workspace:*",
    "@repo/assets": "workspace:*"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18",
    "react-router-dom": ">=6"
  },
  "peerDependenciesMeta": {
    "react": { "optional": true },
    "react-dom": { "optional": true },
    "react-router-dom": { "optional": true }
  },
  "devDependencies": {
    "typescript": "catalog:",
    "rimraf": "catalog:",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.1.6",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.8.0"
  }
}
