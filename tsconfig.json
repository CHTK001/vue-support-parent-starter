{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "jsx": "preserve",
    "sourceMap": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "allowImportingTsExtensions": true,
    "allowArbitraryExtensions": true,
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "skipLibCheck": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@repo/app": ["turbo/app/src"],
      "@repo/template": ["turbo/template"],
      "@repo/config": ["packages/config/src"],
      "@repo/core": ["packages/core/src"],
      "@repo/core/*": ["packages/core/src/*"],
      "@repo/pinia": ["packages/pinia/src"],
      "@repo/pinia/*": ["packages/pinia/src/*"],
      "@repo/ui": ["packages/ui/src"],
      "@repo/ui/components/*": ["packages/ui/src/components/*"],
      // @repo/ui/re-* 子入口（packages/ui/package.json 的 exports 里有 87 个）。
      //
      // 这一段由 `node scripts/gen-ui-entry-paths.mjs` 生成，勿手改；
      // 新增/改名组件后重跑该脚本即可（`--check` 只校验不写）。
      //
      // 为什么必须逐个列出：paths 的 `*` 是原样字符串替换，`re-xxx-yyy` 只会
      // 替换出 kebab 片段（xxx-yyy），而磁盘目录是 PascalCase（ReXxxYyy）。
      // 写成 Re*/index.ts 会得到 components/Resection-head/index.ts，
      // 仅靠 Windows 大小写不敏感「碰巧」命中，并让同一文件产生两种大小写
      // 路径，触发 TS1149「only in casing」；写成多候选回退在 TS 中不成立
      // （不存在的候选会让整个模块判定为找不到，报 TS2307）。
      // 注意：如果目标目录里除了 index.ts 还有 index.d.ts，这里必须两个候选都
      // 写出来。TS 的路由是：先找精确目标，找不到再试 .ts/.tsx/.d.ts 扩展名；
      // 只在最后一步才降级到 * 通配。所以指向 index.ts 而目录里另有 index.d.ts
      // 时，最终解析到的是 index.d.ts（前者成了中间候选），而 index.d.ts 只
      // 声明了默认导出、没有具名导出 component/install，具名导入即报 TS2305。
      // 把 index.d.ts 显式列为候选排在前面，就是「有就优先用它」的写法。
      // 另：模板里用 $t 的 .vue 之所以有类型，靠的是 packages/languages/src/vue-i18n.d.ts
      // 把 vue-i18n 的 declare module "vue" 增强 import 进程序（各应用 types 白名单里没有它）。
      // @repo/ui/re-* begin
      // 以下 90 条由 scripts/gen-ui-entry-paths.mjs 生成，勿手改（组件增删后重跑脚本）。
      "@repo/ui/re-album": ["packages/ui/src/components/ReAlbum/index.ts"],
      "@repo/ui/re-async": ["packages/ui/src/components/ReAsync/index.ts"],
      "@repo/ui/re-avatar-crop": ["packages/ui/src/components/ReAvatarCrop/index.ts"],
      "@repo/ui/re-avatar3d": ["packages/ui/src/components/ReAvatar3D/index.ts"],
      "@repo/ui/re-badge": ["packages/ui/src/components/ReBadge/index.ts"],
      "@repo/ui/re-breadcrumb": ["packages/ui/src/components/ReBreadcrumb/index.ts"],
      "@repo/ui/re-button": ["packages/ui/src/components/ReButton/index.ts"],
      "@repo/ui/re-canvas-ui": ["packages/ui/src/components/ReCanvasUi/index.ts"],
      "@repo/ui/re-card": ["packages/ui/src/components/ReCard/index.ts"],
      "@repo/ui/re-card-textarea": ["packages/ui/src/components/ReCardTextarea/index.ts"],
      "@repo/ui/re-carousel": ["packages/ui/src/components/ReCarousel/index.ts"],
      "@repo/ui/re-chart": ["packages/ui/src/components/ReChart/index.ts"],
      "@repo/ui/re-chat": ["packages/ui/src/components/ReChat/index.ts"],
      "@repo/ui/re-cline-character": ["packages/ui/src/components/ReClineCharacter/index.ts"],
      "@repo/ui/re-code": ["packages/ui/src/components/ReCode/index.ts"],
      "@repo/ui/re-colorize": ["packages/ui/src/components/ReColorize/index.ts"],
      "@repo/ui/re-command": ["packages/ui/src/components/ReCommand/index.ts"],
      "@repo/ui/re-context-menu": ["packages/ui/src/components/ReContextMenu/index.ts"],
      "@repo/ui/re-cost-text": ["packages/ui/src/components/ReCostText/index.ts"],
      "@repo/ui/re-countup": ["packages/ui/src/components/ReCountup/index.ts"],
      "@repo/ui/re-cron": ["packages/ui/src/components/ReCron/index.ts"],
      "@repo/ui/re-cropper": ["packages/ui/src/components/ReCropper/index.ts"],
      "@repo/ui/re-date-picker": ["packages/ui/src/components/ReDatePicker/index.ts"],
      "@repo/ui/re-dialog": ["packages/ui/src/components/ReDialog/index.ts"],
      "@repo/ui/re-drawer": ["packages/ui/src/components/ReDrawer/index.ts"],
      "@repo/ui/re-echarts": ["packages/ui/src/components/ReEcharts/index.ts"],
      "@repo/ui/re-element-picker": ["packages/ui/src/components/ReElementPicker/index.ts"],
      "@repo/ui/re-empty": ["packages/ui/src/components/ReEmpty/index.ts"],
      "@repo/ui/re-empty-state": ["packages/ui/src/components/ReEmptyState/index.d.ts", "packages/ui/src/components/ReEmptyState/index.ts"],
      "@repo/ui/re-file-picker": ["packages/ui/src/components/ReFilePicker/index.ts"],
      "@repo/ui/re-filter": ["packages/ui/src/components/ReFilter/index.ts"],
      "@repo/ui/re-float-window": ["packages/ui/src/components/ReFloatWindow/index.ts"],
      "@repo/ui/re-flow-graph": ["packages/ui/src/components/ReFlowGraph/index.ts"],
      "@repo/ui/re-form": ["packages/ui/src/components/ReForm/index.ts"],
      "@repo/ui/re-icon": ["packages/ui/src/components/ReIcon/index.ts"],
      "@repo/ui/re-icon-select": ["packages/ui/src/components/ReIconSelect/index.ts"],
      "@repo/ui/re-image": ["packages/ui/src/components/ReImage/index.ts"],
      "@repo/ui/re-image-compare": ["packages/ui/src/components/ReImageCompare/index.ts"],
      "@repo/ui/re-image-gen": ["packages/ui/src/components/ReImageGen/index.ts"],
      "@repo/ui/re-image-group": ["packages/ui/src/components/ReImageGroup/index.ts"],
      "@repo/ui/re-input": ["packages/ui/src/components/ReInput/index.ts"],
      "@repo/ui/re-input-number": ["packages/ui/src/components/ReInputNumber/index.ts"],
      "@repo/ui/re-ip": ["packages/ui/src/components/ReIp/index.ts"],
      "@repo/ui/re-ip-text": ["packages/ui/src/components/ReIpText/index.ts"],
      "@repo/ui/re-kit": ["packages/ui/src/components/ReKit/index.ts"],
      "@repo/ui/re-lazy": ["packages/ui/src/components/ReLazy/index.ts"],
      "@repo/ui/re-loader": ["packages/ui/src/components/ReLoader/index.ts"],
      "@repo/ui/re-loading": ["packages/ui/src/components/ReLoading/index.ts"],
      "@repo/ui/re-map3d": ["packages/ui/src/components/ReMap3D/index.ts"],
      "@repo/ui/re-page-kit": ["packages/ui/src/components/RePageKit/index.ts"],
      "@repo/ui/re-pagination": ["packages/ui/src/components/RePagination/index.ts"],
      "@repo/ui/re-placeholder-picker": ["packages/ui/src/components/RePlaceholderPicker/index.ts"],
      "@repo/ui/re-process-task": ["packages/ui/src/components/ReProcessTask/index.ts"],
      "@repo/ui/re-progress": ["packages/ui/src/components/ReProgress/index.ts"],
      "@repo/ui/re-rag-chat": ["packages/ui/src/components/ReRagChat/index.ts"],
      "@repo/ui/re-rag-manager": ["packages/ui/src/components/ReRagManager/index.ts"],
      "@repo/ui/re-relation-graph": ["packages/ui/src/components/ReRelationGraph/index.ts"],
      "@repo/ui/re-remote-select": ["packages/ui/src/components/ReRemoteSelect/index.ts"],
      "@repo/ui/re-ribbon": ["packages/ui/src/components/ReRibbon/index.ts"],
      "@repo/ui/re-rich-text": ["packages/ui/src/components/ReRichText/index.ts"],
      "@repo/ui/re-scroll-nav": ["packages/ui/src/components/ReScrollNav/index.ts"],
      "@repo/ui/re-scrollbar": ["packages/ui/src/components/ReScrollbar/index.ts"],
      "@repo/ui/re-seamless-scroll": ["packages/ui/src/components/ReSeamlessScroll/index.ts"],
      "@repo/ui/re-search": ["packages/ui/src/components/ReSearch/index.ts"],
      "@repo/ui/re-section-head": ["packages/ui/src/components/ReSectionHead/index.d.ts", "packages/ui/src/components/ReSectionHead/index.ts"],
      "@repo/ui/re-select": ["packages/ui/src/components/ReSelect/index.ts"],
      "@repo/ui/re-skeleton": ["packages/ui/src/components/ReSkeleton/index.ts"],
      "@repo/ui/re-split-layout": ["packages/ui/src/components/ReSplitLayout/index.ts"],
      "@repo/ui/re-stat": ["packages/ui/src/components/ReStat/index.ts"],
      "@repo/ui/re-stat-card": ["packages/ui/src/components/ReStatCard/index.d.ts", "packages/ui/src/components/ReStatCard/index.ts"],
      "@repo/ui/re-state-icon": ["packages/ui/src/components/ReStateIcon/index.ts"],
      "@repo/ui/re-station-message": ["packages/ui/src/components/ReStationMessage/index.ts"],
      "@repo/ui/re-stats-card": ["packages/ui/src/components/ReStatsCard/index.d.ts", "packages/ui/src/components/ReStatsCard/index.ts"],
      "@repo/ui/re-status-indicator": ["packages/ui/src/components/ReStatusIndicator/index.ts"],
      "@repo/ui/re-switch": ["packages/ui/src/components/ReSwitch/index.ts"],
      "@repo/ui/re-tab": ["packages/ui/src/components/ReTab/index.ts"],
      "@repo/ui/re-table": ["packages/ui/src/components/ReTable/index.ts"],
      "@repo/ui/re-tabs": ["packages/ui/src/components/ReTabs/index.ts"],
      "@repo/ui/re-tag": ["packages/ui/src/components/ReTag/index.ts"],
      "@repo/ui/re-tag-filter": ["packages/ui/src/components/ReTagFilter/index.ts"],
      "@repo/ui/re-text": ["packages/ui/src/components/ReText/index.ts"],
      "@repo/ui/re-three": ["packages/ui/src/components/ReThree/index.ts"],
      "@repo/ui/re-time": ["packages/ui/src/components/ReTime/index.ts"],
      "@repo/ui/re-timeline": ["packages/ui/src/components/ReTimeline/index.ts"],
      "@repo/ui/re-tree": ["packages/ui/src/components/ReTree/index.ts"],
      "@repo/ui/re-trend": ["packages/ui/src/components/ReTrend/index.ts"],
      "@repo/ui/re-type-it": ["packages/ui/src/components/ReTypeIt/index.ts"],
      "@repo/ui/re-typeit": ["packages/ui/src/components/ReTypeIt/index.ts"],
      "@repo/ui/re-upload": ["packages/ui/src/components/ReUpload/index.ts"],
      "@repo/ui/re-upload-chunk": ["packages/ui/src/components/ReUploadChunk/index.ts"],
      "@repo/ui/re-video-gen": ["packages/ui/src/components/ReVideoGen/index.ts"],
      // @repo/ui/re-* end
      // 线稿图库（加载动画的矢量款 + 空状态图形共用）。
      // 必须显式指向真实目录：包名本身含空格与 "at " 前缀，
      // bundler 解析在 Windows 上不稳定，会报 TS2307。
      "at lucasmarkes/hairline": ["packages/ui/node_modules/at lucasmarkes/hairline/dist/index.d.ts"],
      "@repo/utils": ["packages/utils/src"],
      "@repo/utils/*": ["packages/utils/src/*"],
      "@repo/work": ["packages/work/src"],
      "@repo/work/*": ["packages/work/src/*"],
      "@repo/theme": ["packages/theme/src"],
      "@repo/theme/*": ["packages/theme/src/*"],
      "@repo/theme/koi": ["packages/theme/src/themes/koi"],
      "@repo/theme/koi/*": ["packages/theme/src/themes/koi/*"],
      "@repo/pages": ["packages/pages/src"],
      "@repo/re-map": ["packages/ui/re-map"],
      "@repo/assets": ["packages/assets/src"],
      "@pages/message": ["pages/message/src"],
      "@pages/hotsport": ["pages/hotsport/src"],
      "@pages/hotsport/*": ["pages/hotsport/src/*"],
      "@pages/apm": ["pages/apm/src"],
      "@pages/apm/*": ["pages/apm/*"],
      "@pages/device": ["pages/device/src"],
      "@pages/template": ["pages/template/src"],
      "@pages/template/*": ["pages/template/src/*"],
      "@pages/eduai": ["pages/eduai/src"],
      "@pages/eduai/*": ["pages/eduai/src/*"],
      "@pages/filesystem": ["pages/filesystem/src"],
      "@pages/task": ["pages/task/src"],
      "@pages/monitor": ["pages/monitor/src"],
      "@pages/tunnel": ["pages/tunnel/src"],
      // 通配符必须落在「页面根」而不是「src」，与运行期 vite alias（"@pages/monitor" → pages/monitor）
      // 以及本文件里的 "@pages/server/*" 保持同一口径：业务代码统一写
      // `@pages/monitor/src/api` 这种带 src 的深路径，若通配符目标已含 src，
      // 就会解析成 pages/monitor/src/src/api —— 全部深导入报 TS2307。
      "@pages/monitor/*": ["pages/monitor/*"],
      "@pages/system": ["pages/system/src"],
      "@pages/system/*": ["pages/system/src/*"],
      "@pages/actuator": ["pages/actuator/src"],
      "@pages/actuator/*": ["pages/actuator/src/*"],
      "@pages/server": ["pages/server/src"],
      "@pages/server/*": ["pages/server/*"],
      // Docker 独立页面包：页面根 + 深路径（宿主统一写 @pages/docker/src/...）
      "@pages/docker": ["pages/docker/src"],
      "@pages/docker/*": ["pages/docker/*"],
      "@pages/collect": ["pages/collect"],
      "@pages/collect/*": ["pages/collect/*"],
      "@pages/ai": ["pages/ai/src"],
      "@pages/ai/*": ["pages/ai/src/*"],
      /* 渠道管理页：已从 pages/ai 抽离为独立包 @pages/channel */
      "@pages/channel": ["pages/channel/src"],
      "@pages/channel/*": ["pages/channel/src/*"],
      // pages/ai 的页面（ModelsPage 等）用 `@/` 指向 pages/ai/src。宿主（如系统平台，无自有
      // paths、继承本文件）嵌入这些页面时靠此解析。自带 `@/*` 的应用（geo/video/ai-guada）
      // 有自己的 paths 会覆盖本项，不受影响；`@/*` 只匹配 `@/…`，不波及 @repo/*、@pages/*。
      "@/*": ["pages/ai/src/*"]
    }
  },
  "include": [],
  "exclude": ["node_modules"]
}
