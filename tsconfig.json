{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "jsx": "preserve",
    "sourceMap": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "allowImportingTsExtensions": true,
    "allowArbitraryExtensions": true,
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "skipLibCheck": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@repo/app": ["turbo/app/src"],
      "@repo/template": ["turbo/template"],
      "@repo/config": ["packages/config/src"],
      "@repo/core": ["packages/core/src"],
      "@repo/core/*": ["packages/core/src/*"],
      "@repo/pinia": ["packages/pinia/src"],
      "@repo/pinia/*": ["packages/pinia/src/*"],
      "@repo/ui": ["packages/ui/src"],
      "@repo/ui/components/*": ["packages/ui/src/components/*"],
      // @repo/ui/re-* 全部走通配，不再逐个手写。
      //
      // 此前这里只手写了 5 个（re-ip-text / re-ip-select / re-icon-select /
      // re-table / re-icon），而 packages/ui 的 exports 有 86 个 ./re-* 入口
      // （已核对：全部指向 src/components/ReXxxYyy/index.ts，且可一一从
      // kebab-case 推导出目录名）。结果 @repo/ui/re-section-head 这类声明的
      // entry 在 TS 里解析不到，报 TS2307「Cannot find module」。
      "@repo/ui/re-*": ["packages/ui/src/components/Re*/index.ts"],
      "@repo/utils": ["packages/utils/src"],
      "@repo/utils/*": ["packages/utils/src/*"],
      "@repo/work": ["packages/work/src"],
      "@repo/work/*": ["packages/work/src/*"],
      "@repo/theme": ["packages/theme/src"],
      "@repo/theme/*": ["packages/theme/src/*"],
      "@repo/theme/koi": ["packages/theme/src/themes/koi"],
      "@repo/theme/koi/*": ["packages/theme/src/themes/koi/*"],
      "@repo/pages": ["packages/pages/src"],
      "@repo/re-map": ["packages/ui/re-map"],
      "@repo/assets": ["packages/assets/src"],
      "@pages/message": ["pages/message/src"],
      "@pages/hotsport": ["pages/hotsport/src"],
      "@pages/hotsport/*": ["pages/hotsport/src/*"],
      "@pages/device": ["pages/device/src"],
      "@pages/eduai": ["pages/eduai/src"],
      "@pages/filesystem": ["pages/filesystem/src"],
      "@pages/task": ["pages/task/src"],
      "@pages/monitor": ["pages/monitor/src"],
      "@pages/monitor/*": ["pages/monitor/src/*"],
      "@pages/system": ["pages/system/src"],
      "@pages/system/*": ["pages/system/src/*"],
      "@pages/server": ["pages/server/src"],
      "@pages/server/*": ["pages/server/*"],
      "@pages/collect": ["pages/collect"],
      "@pages/collect/*": ["pages/collect/*"],
      "@pages/ai": ["pages/ai/src"],
      "@pages/ai/*": ["pages/ai/src/*"],
      // pages/ai 的页面（ModelsPage 等）用 `@/` 指向 pages/ai/src。宿主（如系统平台，无自有
      // paths、继承本文件）嵌入这些页面时靠此解析。自带 `@/*` 的应用（geo/video/ai-guada）
      // 有自己的 paths 会覆盖本项，不受影响；`@/*` 只匹配 `@/…`，不波及 @repo/*、@pages/*。
      "@/*": ["pages/ai/src/*"]
    }
  },
  "include": [],
  "exclude": ["node_modules"]
}
