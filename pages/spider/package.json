{
  "name": "@pages/spider",
  "version": "1.0.0",
  "description": "可视化编排爬虫模块",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm unbuild",
    "prepublishOnly": "npm run build"
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "**/*.vue",
    "**/*.scss"
  ],
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./router/*": {
      "types": "./src/router/*.ts",
      "default": "./src/router/*.ts"
    },
    "./api/*": {
      "types": "./src/api/*.ts",
      "default": "./src/api/*.ts"
    },
    "./views/*": {
      "default": "./src/views/*"
    }
  },
  "publishConfig": {
    "exports": {
      ".": {
        "default": "./dist/index.mjs"
      },
      "./router/*": {
        "default": "./dist/router/*.mjs"
      },
      "./api/*": {
        "default": "./dist/api/*.mjs"
      },
      "./views/*": {
        "default": "./dist/views/*"
      }
    }
  },
  "dependencies": {
    "@repo/config": "workspace:^",
    "element-plus": "catalog:",
    "vue": "catalog:",
    "vue-router": "catalog:"
  },
  "devDependencies": {
    "@repo/core": "workspace:^",
    "@repo/tailwind-config": "workspace:^",
    "@repo/tsconfig": "workspace:^",
    "@types/node": "catalog:",
    "sass": "catalog:",
    "typescript": "catalog:",
    "unbuild": "catalog:",
    "vite": "catalog:",
    "vue-tsc": "catalog:"
  }
}
