{
  "compilerOptions": {
    /* 语言和模块配置 */
    "target": "ES2020",
    "module": "ESNext",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,

    /* 类型检查 - 与 AI 控制台原 tsconfig 保持一致，避免归档后触发新错误 */
    "strict": false,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "strictFunctionTypes": true,
    "strictBindCallApply": true,
    "strictPropertyInitialization": false,
    "noImplicitThis": true,
    "alwaysStrict": true,

    /* 未使用的代码检查 - 初期关闭 */
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noImplicitReturns": false,
    "noFallthroughCasesInSwitch": false,

    /* 互操作性 */
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "forceConsistentCasingInFileNames": true,

    /* 输出配置 */
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "removeComments": false,

    /* 性能优化 */
    "skipLibCheck": true,
    "isolatedModules": true,

    /* Vue 特定配置 */
    "jsx": "preserve",
    "jsxFactory": "h",
    "jsxFragmentFactory": "Fragment",

    /* 路径解析 */
    "baseUrl": ".",
    /* ignoreDeprecations：与 catalog 锁定的 TypeScript 5.x 对应（"6.0" 是 TS6 才接受的值） */
    "ignoreDeprecations": "5.0",
    "paths": {
      "@/*": ["./src/*"],
      "@pages/filesystem": ["../filesystem/src/index.ts"],
      "@pages/filesystem/*": ["../filesystem/*"],
      /* 渠道管理页：已从 pages/ai 抽离出的独立包（见「系统设置 → 渠道管理」） */
      "@pages/channel": ["../channel/src/index.ts"],
      "@pages/channel/*": ["../channel/src/*"],
      /* CDP 实时页面组件：已从 pages/ai 抽离出的独立包（账号登录弹窗） */
      "@pages/cdp": ["../cdp/src/index.ts"],
      "@pages/cdp/*": ["../cdp/src/*"],
      /* 浏览器本地推理包：pnpm workspace 链接未就绪时类型检查直读源码（其余 @repo/* 走 node_modules 链接）。
         注意：只映射 web-llm 这类小包；@repo/theme、@repo/languages 的深路径若直读源码，
         会把整棵主题/语言包拖进类型程序，内存突破看门狗 3GB 红线被击杀（BUILD-OVER-MEMORY），
         那些深路径改用 src/types/shims-deep-imports.d.ts 的环境模块声明。 */
      "@repo/web-llm": ["../../packages/ui/web-llm/src/index.ts"],
      "@repo/web-llm/worker": ["../../packages/ui/web-llm/src/worker.ts"]
    },

    /* 类型根目录 */
    "typeRoots": ["./node_modules/@types", "./src/types"]
  },

  "include": [
    "src/**/*.ts",
    "src/**/*.d.ts",
    "src/**/*.tsx",
    "src/**/*.vue",
    "../filesystem/src/**/*.d.ts",
    "../channel/src/**/*.d.ts",
    "../cdp/src/**/*.d.ts"
  ],

  "exclude": ["node_modules", "dist", "build"],

  "vueCompilerOptions": {
    "target": 3.5,
    "plugins": []
  }
}