// main.ts 注册片段
import { createApp } from 'vue';
import App from './App.vue';
import { roleDirective, setUserRoles } from './directives/role';

const app = createApp(App);

// 注册 v-role 权限指令
app.directive('role', roleDirective);

// 应用启动时根据后端返回的用户信息设置角色
// 实际使用时，从用户登录接口或用户信息接口获取角色列表并注入
// 例如：
// const userInfo = await fetch('/api/current-user').then(r => r.json());
// setUserRoles(userInfo.roles || []);

app.mount('#app');