{
  "$schema": "http://json-schema.org/draft-04/schema#",
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": false,
    "jsx": "preserve",
    "importHelpers": true,
    "experimentalDecorators": true,
    "strictFunctionTypes": false,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "allowSyntheticDefaultImports": true,
    "forceConsistentCasingInFileNames": true,
    "sourceMap": true,
    "baseUrl": ".",
    "allowJs": true,
    "resolveJsonModule": true,
    "lib": ["ESNext", "DOM", "ES2022"],
    "paths": {
      "@/*": ["src/*"],
      "@build/*": ["build/*"],
      "@repo/codec-wasm": ["../../packages/codec-wasm/src/index.js"],
      "@repo/components": ["../../packages/components/index.ts"],
      "@repo/components/*": [
        "../../packages/components/*",
        "../../packages/components-standalone/*"
      ],
      "@pages/common": ["../../pages/common"],
      "@pages/common/*": ["../../pages/common/*"]
    },
    "types": [
      "node",
      "vite/client",
      "element-plus/global",
      "@pureadmin/table/volar",
      "@pureadmin/descriptions/volar"
    ]
  },
  "include": [
    "env.d.ts",
    "@repo/core",
    "../../packages/types/*.d.ts",
    "**/*.ts",
    "src/**/*.ts",
    "src/**/*.tsx",
    "src/**/*.vue",
    "vite.config.ts"
  ],
  "exclude": [
    "dist",
    "**/*.js",
    "node_modules",
    "**/node_modules/**",
    "**/dist/**",
    "**/.turbo/**"
  ]
}
