{
  "name": "@layout/bigscreen",
  "version": "1.0.0",
  "description": "TechUI SciFi 大屏可视化编辑器",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./*": "./src/*"
  },
  "sideEffects": [
    "**/*.css",
    "**/*.scss",
    "**/*.vue"
  ],
  "dependencies": {
    "@repo/components": "workspace:^",
    "@repo/utils": "workspace:*",
    "@vueuse/core": "catalog:",
    "interactjs": "catalog:",
    "nanoid": "catalog:",
    "unbuild": "catalog:",
    "vue": "catalog:",
    "vue-router": "catalog:"
  }
}
