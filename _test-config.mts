import { parseAppYaml, mergeAppConfig } from "./packages/config/src/config.ts";
import { readFileSync } from "fs";
const yaml = readFileSync("./apps/system/app.yaml", "utf-8");
const partial = parseAppYaml(yaml);
console.log("routeConfig 顶层键存在:", "route" in partial, Object.keys(partial).join(","));
const merged = mergeAppConfig(partial);
console.log("route.mode:", merged.route.mode);
console.log("route.whiteList:", JSON.stringify(merged.route.whiteList));
console.log("route.homePath:", merged.route.homePath);
console.log("route.mergeLocalMenu:", merged.route.mergeLocalMenu);
console.log("app.title:", merged.app.title);
